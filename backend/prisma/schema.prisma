generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

enum AccountType {
  CONTA_CORRENTE
  DINHEIRO
  CARTAO_CREDITO
}

enum CategoryType {
  RECEITA
  DESPESA
}

enum TransactionType {
  RECEITA
  DESPESA
}

enum ReminderTipo {
  ENTRADA
  SAIDA
}

enum ReminderRecorrencia {
  MENSAL
  UNICO
}

model Account {
  id            String      @id @default(cuid())
  nome          String
  tipo          AccountType
  limite        Decimal?
  diaFechamento Int?        @map("dia_fechamento")
  diaVencimento Int?        @map("dia_vencimento")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  transactions  Transaction[]
  purchases     Purchase[]
  fixedExpenses FixedExpense[]

  @@map("accounts")
}

model Category {
  id         String       @id @default(cuid())
  nome       String
  tipo       CategoryType
  icone      String?
  cor        String?
  metaMensal Decimal?     @map("meta_mensal")

  transactions  Transaction[]
  purchases     Purchase[]
  fixedExpenses FixedExpense[]

  @@map("categories")
}

model Purchase {
  id             String   @id @default(cuid())
  accountId      String   @map("account_id")
  categoryId     String   @map("category_id")
  valorTotal     Decimal  @map("valor_total")
  descricao      String
  dataCompra     DateTime @map("data_compra")
  numeroParcelas Int      @map("numero_parcelas")
  createdAt      DateTime @default(now()) @map("created_at")

  account      Account       @relation(fields: [accountId], references: [id])
  category     Category      @relation(fields: [categoryId], references: [id])
  transactions Transaction[]

  @@map("purchases")
}

model WebauthnCredential {
  id           String   @id @default(cuid())
  credentialId String   @unique @map("credential_id")
  publicKey    Bytes    @map("public_key")
  counter      BigInt
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("webauthn_credentials")
}

model Transaction {
  id             String          @id @default(cuid())
  accountId      String          @map("account_id")
  categoryId     String          @map("category_id")
  valor          Decimal
  descricao      String
  data           DateTime
  tipo           TransactionType
  purchaseId     String?         @map("purchase_id")
  fixedExpenseId String?         @map("fixed_expense_id")
  parcelaNumero  Int?            @map("parcela_numero")
  parcelaTotal   Int?            @map("parcela_total")
  createdAt      DateTime        @default(now()) @map("created_at")

  account      Account       @relation(fields: [accountId], references: [id])
  category     Category      @relation(fields: [categoryId], references: [id])
  purchase     Purchase?     @relation(fields: [purchaseId], references: [id])
  fixedExpense FixedExpense? @relation(fields: [fixedExpenseId], references: [id])

  @@index([accountId, data])
  @@index([purchaseId])
  @@index([fixedExpenseId])
  @@map("transactions")
}

model FixedExpense {
  id         String   @id @default(cuid())
  accountId  String   @map("account_id")
  categoryId String   @map("category_id")
  valor      Decimal
  descricao  String
  dataInicio DateTime @map("data_inicio")
  status     String   @default("ACTIVE") // ACTIVE ou CANCELED
  createdAt  DateTime @default(now()) @map("created_at")

  account      Account       @relation(fields: [accountId], references: [id])
  category     Category      @relation(fields: [categoryId], references: [id])
  transactions Transaction[]
  reminders    Reminder[]

  @@map("fixed_expenses")
}

// Lembrete de entrada/saída: só notifica (Web Push + Discord), nunca afeta saldo.
// É uma regra de recorrência, não um lançamento — ver docs/architecture.md.
model Reminder {
  id               String              @id @default(cuid())
  titulo           String
  tipo             ReminderTipo
  valor            Decimal?
  recorrencia      ReminderRecorrencia
  diaDoMes         Int?                @map("dia_do_mes")
  dataUnica        DateTime?           @map("data_unica")
  horario          String              @default("09:00") // HH:mm no fuso REMINDERS_TZ
  diasAntecedencia Int                 @default(0) @map("dias_antecedencia")
  ativo            Boolean             @default(true)
  proximoDisparo   DateTime?           @map("proximo_disparo") // null = sem próximo disparo
  ultimoDisparo    DateTime?           @map("ultimo_disparo")
  fixedExpenseId   String?             @map("fixed_expense_id")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  fixedExpense FixedExpense? @relation(fields: [fixedExpenseId], references: [id])

  @@index([ativo, proximoDisparo])
  @@index([fixedExpenseId])
  @@map("reminders")
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("push_subscriptions")
}
