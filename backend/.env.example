DATABASE_URL="file:./prisma/dev.db"
PORT=3000
NODE_ENV=development

# Single-user login password (plaintext — see docs/web-architecture.md for why that's acceptable here)
AUTH_PASSWORD="change-me"
# Random 32+ byte secret used to sign issued auth tokens, e.g. `openssl rand -base64 32`
AUTH_TOKEN_SECRET="change-me"
# Nome exibido na saudação da Home ("Olá, Andrey"); opcional — se vazio, a saudação não aparece.
AUTH_USER_NAME="Andrey"

# WebAuthn (Face ID/Touch ID) relying-party config
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="Meu Dinheirinho"
WEBAUTHN_ORIGIN="http://localhost:5173"
